<resources>
    <style name="Theme.NequiClone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nequi_green</item>
        <item name="colorPrimaryDark">@color/nequi_green</item>
        <item name="colorSecondary">@color/nequi_pink</item>
        <item name="android:windowBackground">@color/nequi_dark</item>
        <item name="materialButtonStyle">@style/Widget.NequiClone.Button</item>
    </style>

    <style name="Widget.NequiClone.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/nequi_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.NequiClone.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/nequi_green</item>
        <item name="android:textColor">@color/nequi_green</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
